<!doctype html><html lang="de"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><meta name="theme-color" content="#0b1220"><title>Ballonflugbuch V2</title><link rel="manifest" href="manifest.webmanifest"><link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"><style>
:root{--bg:#07101d;--card:#101c2e;--card2:#14243a;--text:#edf5ff;--muted:#91a3bb;--accent:#5cc8ff;--good:#55d68a;--warn:#ffd166;--danger:#ff6b6b}*{box-sizing:border-box}body{margin:0;font-family:system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;background:linear-gradient(180deg,#07101d,#0b1626);color:var(--text)}button,input,select,textarea{font:inherit}button{border:0;border-radius:14px;padding:12px 15px;background:var(--card2);color:var(--text);cursor:pointer}button.primary{background:var(--accent);color:#06111c;font-weight:700}button.good{background:var(--good);color:#07150e;font-weight:700}button.danger{background:var(--danger);color:#220606}.app{display:flex;min-height:100vh}.side{width:240px;background:#081321;border-right:1px solid #1c2b40;padding:22px 14px;position:sticky;top:0;height:100vh}.brand{font-weight:800;font-size:19px;margin:0 8px 24px}.brand small{display:block;color:var(--muted);font-size:11px;font-weight:500;margin-top:4px}.nav button{width:100%;text-align:left;margin:4px 0;background:transparent;color:#b8c6d8}.nav button.active,.nav button:hover{background:#14243a;color:white}.content{flex:1;max-width:1500px;margin:auto;padding:22px 22px 90px}.top{display:flex;justify-content:space-between;gap:12px;align-items:center;margin-bottom:18px}.top h1{font-size:25px;margin:0}.grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px}.card{background:rgba(16,28,46,.92);border:1px solid #20334d;border-radius:18px;padding:17px;box-shadow:0 10px 35px rgba(0,0,0,.15)}.metric b{font-size:28px;display:block;margin-top:7px}.muted{color:var(--muted);font-size:13px}.section{margin-top:16px}.row{display:flex;gap:10px;flex-wrap:wrap;align-items:center}.field{display:flex;flex-direction:column;gap:6px;min-width:150px;flex:1}.field label{font-size:12px;color:var(--muted)}input,select,textarea{background:#0a1625;color:var(--text);border:1px solid #263c57;border-radius:11px;padding:11px;width:100%}.split{display:grid;grid-template-columns:360px 1fr;gap:14px}.map{height:520px;border-radius:16px;overflow:hidden;background:#0b1727}.smallmap{height:300px}.routebox{display:flex;gap:10px;flex-wrap:wrap;margin-top:10px}.pill{padding:8px 10px;border-radius:999px;background:#162941;color:#bcd0e8;font-size:12px}.weather{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}.weather .card{padding:12px}.hidden{display:none!important}.mobile-nav{display:none}.list{display:flex;flex-direction:column;gap:8px}.flight{display:grid;grid-template-columns:1fr auto;gap:12px;align-items:center}.flight strong{display:block}.empty{padding:30px;text-align:center;color:var(--muted)}.live{font-size:34px;font-weight:800}.warning{border-left:4px solid var(--warn);padding:12px;background:#231f12;border-radius:10px;color:#f4dda0}.ok{color:var(--good)}
@media(max-width:900px){.side{display:none}.content{padding:16px 14px 90px}.grid{grid-template-columns:repeat(2,1fr)}.split{grid-template-columns:1fr}.map{height:430px}.weather{grid-template-columns:repeat(2,1fr)}.mobile-nav{display:flex;position:fixed;bottom:0;left:0;right:0;background:#081321;border-top:1px solid #20334d;z-index:9999;padding:8px 6px;justify-content:space-around}.mobile-nav button{font-size:11px;padding:9px 8px;background:transparent}.mobile-nav button.active{color:var(--accent)}}@media(max-width:520px){.grid{grid-template-columns:1fr 1fr}.metric b{font-size:23px}.top h1{font-size:21px}.row .field{min-width:100%}}
</style></head><body><div class="app"><aside class="side"><div class="brand">🎈 Ballonflugbuch <small>Professional V2</small></div><nav class="nav"><button data-page="home">⌂ Übersicht</button><button data-page="plan">🗺️ Flugplanung</button><button data-page="flight">▶ Fahrt</button><button data-page="book">📖 Flugbuch</button><button data-page="data">⚙ Stammdaten & Backup</button></nav></aside><main class="content"><div class="top"><h1 id="title">Übersicht</h1><div class="row"><span id="gpsStatus" class="pill">GPS: aus</span><button id="backupBtn">⇩ Backup</button></div></div>
<section id="page-home"><div class="grid"><div class="card metric"><span class="muted">Fahrten</span><b id="mFlights">0</b></div><div class="card metric"><span class="muted">Landungen</span><b id="mLandings">0</b></div><div class="card metric"><span class="muted">Flugzeit</span><b id="mTime">0:00 h</b></div><div class="card metric"><span class="muted">Strecke</span><b id="mDistance">0.0 km</b></div></div><div class="section grid"><div class="card"><h3>Nächster Schritt</h3><p class="muted">Plane einen Flug und übernimm ihn direkt in die GPS-Fahrt.</p><button class="primary" onclick="show('plan')">🗺️ Fahrt planen</button></div><div class="card"><h3>Live-Fahrt</h3><p id="homeLive" class="muted">Keine aktive Fahrt.</p><button onclick="show('flight')">▶ Fahrt öffnen</button></div><div class="card"><h3>Wetter</h3><div id="homeWeather" class="muted">Noch keine Position.</div><button onclick="locateWeather()">🌦️ Wetter aktualisieren</button></div><div class="card"><h3>Stammdaten</h3><div id="homeMaster" class="muted"></div><button onclick="show('data')">⚙ Bearbeiten</button></div></div><div class="section card"><h3>Letzte Flüge</h3><div id="recent" class="list"></div></div></section>
<section id="page-plan" class="hidden"><div class="split"><div class="card"><h3>Flugplanung</h3><div class="field"><label>Startort / Suche</label><div class="row"><input id="place" placeholder="z. B. Hartberg"><button onclick="searchPlace()">Suchen</button></div></div><div class="row"><div class="field"><label>Datum</label><input id="pDate" type="date"></div><div class="field"><label>Startzeit</label><input id="pTime" type="time"></div></div><div class="row"><div class="field"><label>Flugdauer (h)</label><input id="pDur" type="number" step="0.5" value="1.5" min="0.5" max="8"></div><div class="field"><label>Haupt-/Referenzhöhe (m AGL)</label><select id="pAlt"><option>500</option><option>800</option><option selected>1000</option><option>1200</option><option>1500</option><option>1800</option><option>2000</option><option>2500</option></select></div></div><div class="card section" style="background:#0b1727"><h4 style="margin:0 0 10px">Höhenvergleich – mehrere Höhen gleichzeitig</h4><div class="muted" style="margin-bottom:10px">Alle ausgewählten Höhen werden gleichzeitig auf der Karte simuliert.</div><div id="heightChecks" class="row"></div></div><div class="row"><button onclick="useMyLocation()">◎ GPS-Start</button><button onclick="getPlanWeather()">🌦️ Wetter</button><button class="primary" onclick="simulate()">💨 Drift berechnen</button></div><div id="planResult" class="section"></div><div class="warning section">Modellwerte dienen der Planung und ersetzen keine offizielle Flugwetterberatung bzw. Luftfahrtinformationen.</div></div><div id="planMap" class="map"></div></div><div class="section card"><h3>Windprofil</h3><div id="windProfile" class="weather"></div></div></section>
<section id="page-flight" class="hidden"><div class="grid"><div class="card"><span class="muted">Flugzeit</span><div id="liveTime" class="live">0:00</div></div><div class="card"><span class="muted">Distanz</span><div id="liveDist" class="live">0.00 km</div></div><div class="card"><span class="muted">Höhe</span><div id="liveAlt" class="live">– m</div></div><div class="card"><span class="muted">Geschwindigkeit</span><div id="liveSpeed" class="live">– km/h</div></div></div><div class="section split"><div class="card"><h3>Fahrtsteuerung</h3><div id="activePlan" class="muted">Keine Planung übernommen.</div><div class="row section"><button class="good" onclick="startFlight()">▶ Fahrt starten</button><button class="danger" onclick="stopFlight()">■ Fahrt beenden</button></div><div class="field section"><label>Landungen</label><input id="landings" type="number" min="0" value="1"></div><div class="field section"><label>Bemerkungen</label><textarea id="remarks" rows="4"></textarea></div><button class="primary section" onclick="saveFlight()">💾 Fahrt ins Flugbuch speichern</button><div id="gpsDetail" class="section muted"></div></div><div id="flightMap" class="map"></div></div></section>
<section id="page-book" class="hidden"><div class="card"><div class="row"><h3 style="margin-right:auto">Flugbuch</h3><button onclick="exportCSV()">CSV Export</button></div><div id="bookList" class="list section"></div></div></section>
<section id="page-data" class="hidden"><div class="grid"><div class="card"><h3>Pilot & Ballon</h3><div class="field"><label>Pilot</label><input id="pilot"></div><div class="field"><label>Ballon-Kennzeichen</label><input id="balloon"></div><div class="field"><label>Ballontyp</label><input id="type"></div><div class="field"><label>Nächste Wartung</label><input id="service" type="date"></div><button class="primary section" onclick="saveMaster()">Speichern</button></div><div class="card"><h3>Datensicherung</h3><p class="muted">Alle Flüge werden lokal im Browser gespeichert.</p><button onclick="exportJSON()">⇩ JSON Backup</button><input class="section" type="file" id="importFile" accept="application/json"><button class="section" onclick="importJSON()">⇧ Backup importieren</button><button class="danger section" onclick="clearAll()">Alle Flüge löschen</button></div></div></section></main></div><div class="mobile-nav"><button data-page="home">⌂<br>Home</button><button data-page="plan">🗺️<br>Plan</button><button data-page="flight">▶<br>Flug</button><button data-page="book">📖<br>Buch</button><button data-page="data">⚙<br>Mehr</button></div>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script><script>
const S={flights:JSON.parse(localStorage.getItem('bf2_flights')||'[]'),master:JSON.parse(localStorage.getItem('bf2_master')||'{}'),plan:null,track:[],watch:null,startTs:null,flightActive:false,lastPos:null,distance:0,planMap:null,flightMap:null,planLine:null,planLines:[],planEndMarkers:[],flightLine:null,marker:null};
const $=id=>document.getElementById(id);function save(){localStorage.setItem('bf2_flights',JSON.stringify(S.flights));localStorage.setItem('bf2_master',JSON.stringify(S.master));render()}
function show(page){document.querySelectorAll('main section[id^=page-]').forEach(x=>x.classList.add('hidden'));$('page-'+page).classList.remove('hidden');document.querySelectorAll('[data-page]').forEach(b=>b.classList.toggle('active',b.dataset.page===page));$('title').textContent={home:'Übersicht',plan:'Flugplanung',flight:'GPS-Fahrt',book:'Flugbuch',data:'Stammdaten & Backup'}[page];if(page==='plan')initPlanMap();if(page==='flight')initFlightMap();if(page==='book')renderBook()}
document.querySelectorAll('[data-page]').forEach(b=>b.onclick=()=>show(b.dataset.page));
function initMap(id){const m=L.map(id).setView([47.25,15.97],8);L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',{attribution:'© OpenStreetMap contributors'}).addTo(m);return m}
function initPlanMap(){if(S.planMap){setTimeout(()=>S.planMap.invalidateSize(),200);return;}S.planMap=initMap('planMap');S.planMap.on('click',e=>setPlanPoint(e.latlng.lat,e.latlng.lng));setTimeout(()=>S.planMap.invalidateSize(),200);initHeightChecks()}
function initFlightMap(){if(S.flightMap)return;S.flightMap=initMap('flightMap');if(S.track.length)drawTrack()}
function setPlanPoint(lat,lon){S.plan={lat,lon};if(S.planMarker)S.planMarker.remove();S.planMarker=L.marker([lat,lon]).addTo(S.planMap).bindPopup('Startpunkt').openPopup();S.planMap.setView([lat,lon],12);$('planResult').innerHTML=`<span class="pill">Start: ${lat.toFixed(5)}, ${lon.toFixed(5)}</span>`}
async function useMyLocation(){navigator.geolocation.getCurrentPosition(p=>setPlanPoint(p.coords.latitude,p.coords.longitude),e=>alert('GPS nicht verfügbar: '+e.message),{enableHighAccuracy:true})}
async function searchPlace(){const q=$('place').value.trim();if(!q)return;try{const r=await fetch('https://nominatim.openstreetmap.org/search?format=json&limit=1&countrycodes=at&q='+encodeURIComponent(q));const d=await r.json();if(!d[0])return alert('Ort nicht gefunden');setPlanPoint(+d[0].lat,+d[0].lon)}catch(e){alert('Suche fehlgeschlagen')}}
async function getPlanWeather(){if(!S.plan)return alert('Bitte zuerst Startpunkt wählen.');try{const d=await fetch(`https://api.open-meteo.com/v1/forecast?latitude=${S.plan.lat}&longitude=${S.plan.lon}&current=temperature_2m,wind_speed_10m,wind_direction_10m,wind_gusts_10m&hourly=temperature_2m,wind_speed_10m,wind_direction_10m,wind_gusts_10m&forecast_days=2&timezone=auto`).then(r=>r.json());const h=d.hourly;const now=new Date();let idx=0;const target=new Date(($('pDate').value||new Date().toISOString().slice(0,10))+'T'+($('pTime').value||'12:00'));let best=1e99;h.time.forEach((t,i)=>{const diff=Math.abs(new Date(t)-target);if(diff<best){best=diff;idx=i}});$('planResult').innerHTML=`<div class="row"><span class="pill">${h.temperature_2m[idx]} °C</span><span class="pill">Wind ${h.wind_speed_10m[idx]} km/h</span><span class="pill">${h.wind_direction_10m[idx]}°</span><span class="pill">Böen ${h.wind_gusts_10m[idx]} km/h</span></div>`}catch(e){alert('Wetter konnte nicht geladen werden')}}
const HEIGHTS=[500,800,1000,1200,1500,1800,2000,2500];
const HEIGHT_PRESSURE={500:950,800:925,1000:900,1200:875,1500:850,1800:825,2000:800,2500:775};
function initHeightChecks(){if(!$('heightChecks'))return;$('heightChecks').innerHTML=HEIGHTS.map((h,i)=>`<label class="pill" style="cursor:pointer"><input type="checkbox" class="hcheck" value="${h}" ${[500,1000,1500,2000,2500].includes(h)?'checked':''} style="width:auto;margin-right:6px">${h} m</label>`).join('')}
function selectedHeights(){return [...document.querySelectorAll('.hcheck:checked')].map(x=>+x.value)}
function clearPlanLines(){if(!S.planMap)return;S.planLines?.forEach(x=>x.remove());S.planLines=[];S.planEndMarkers?.forEach(x=>x.remove());S.planEndMarkers=[];if(S.planLine){S.planLine.remove();S.planLine=null}}
function projectPoint(lat,lon,dist,dir){const rad=(dir+180)*Math.PI/180;return {lat:lat+(dist*Math.cos(rad))/111,lon:lon+(dist*Math.sin(rad))/(111*Math.cos(lat*Math.PI/180))}}
async function simulate(){if(!S.plan)return alert('Startpunkt wählen.');const heights=selectedHeights();if(!heights.length)return alert('Bitte mindestens eine Höhe auswählen.');const dur=+$('pDur').value||1.5;const refAlt=+$('pAlt').value||1000;try{const pressure=[...new Set(heights.map(h=>HEIGHT_PRESSURE[h]))];const vars=pressure.flatMap(p=>[`wind_speed_${p}hPa`,`wind_direction_${p}hPa`]);const d=await fetch(`https://api.open-meteo.com/v1/forecast?latitude=${S.plan.lat}&longitude=${S.plan.lon}&hourly=${vars.join(',')}&forecast_days=2&timezone=auto`).then(r=>r.json());const target=new Date(($('pDate').value||new Date().toISOString().slice(0,10))+'T'+($('pTime').value||'12:00'));let idx=0,best=1e99;d.hourly.time.forEach((t,i)=>{const diff=Math.abs(new Date(t)-target);if(diff<best){best=diff;idx=i}});clearPlanLines();S.planLines=[];S.planEndMarkers=[];const colors=['#5cc8ff','#55d68a','#ffd166','#ff8fab','#b794f4','#ff9f43','#2dd4bf','#f87171'];const results=[];for(const [i,h] of heights.entries()){const p=HEIGHT_PRESSURE[h];const speed=Number(d.hourly[`wind_speed_${p}hPa`]?.[idx] ?? 15);const dir=Number(d.hourly[`wind_direction_${p}hPa`]?.[idx] ?? 270);const dist=Math.max(0.1,speed*dur);const end=projectPoint(S.plan.lat,S.plan.lon,dist,dir);const line=L.polyline([[S.plan.lat,S.plan.lon],[end.lat,end.lon]],{dashArray:'8 8',weight:h===refAlt?7:4,opacity:h===refAlt?1:.78,color:colors[i%colors.length]}).addTo(S.planMap);line.bindTooltip(`${h} m · ${speed.toFixed(1)} km/h · ${dir}°`,{sticky:true});const marker=L.circleMarker([end.lat,end.lon],{radius:7,weight:2,fillOpacity:.9,color:colors[i%colors.length]}).addTo(S.planMap).bindPopup(`<b>${h} m</b><br>Drift: ${dist.toFixed(1)} km<br>Wind: ${speed.toFixed(1)} km/h<br>Richtung: ${dir}°`);S.planLines.push(line);S.planEndMarkers.push(marker);results.push({height:h,speed,dir,dist,end});}const allPts=[[S.plan.lat,S.plan.lon],...results.map(r=>[r.end.lat,r.end.lon])];S.planMap.fitBounds(L.latLngBounds(allPts),{padding:[30,30]});S.plan.heightRuns=results;S.plan.alt=refAlt;S.plan.duration=dur;S.plan.end=results.find(r=>r.height===refAlt)||results[0];$('planResult').innerHTML=`<div class="row"><span class="pill">${heights.length} Höhen aktiv</span><span class="pill">${dur} h</span><span class="pill">Referenz: ${refAlt} m</span></div><div class="section"><b>Höhenvergleich</b><div class="list section">${results.map(r=>`<div class="flight"><div><strong>${r.height} m</strong><span class="muted">Wind ${r.speed.toFixed(1)} km/h · Richtung ${Math.round(r.dir)}°</span></div><span class="pill">${r.dist.toFixed(1)} km Drift</span></div>`).join('')}</div></div>`;$('windProfile').innerHTML=results.map((r,i)=>`<div class="card" style="border-left:4px solid ${colors[i%colors.length]}"><b>${r.height} m</b><br><span class="muted">${r.speed.toFixed(1)} km/h · ${Math.round(r.dir)}°</span><br><strong>${r.dist.toFixed(1)} km</strong> Drift</div>`).join('');$('activePlan').innerHTML=`Geplant: ${dur} h · Referenz ${refAlt} m · ${heights.length} Höhen · Start ${S.plan.lat.toFixed(4)}, ${S.plan.lon.toFixed(4)}` }catch(e){console.error(e);alert('Höhen-Simulation fehlgeschlagen. Prüfe Internetverbindung und Wetterdaten.')}}
function startFlight(){if(S.flightActive)return;S.flightActive=true;S.startTs=Date.now();S.track=[];S.distance=0;S.lastPos=null;initFlightMap();if(S.flightLine)S.flightLine.remove();S.flightLine=L.polyline([],{weight:5}).addTo(S.flightMap);if(!navigator.geolocation)return alert('GPS wird vom Browser nicht unterstützt.');S.watch=navigator.geolocation.watchPosition(onPos,e=>{$('gpsDetail').textContent='GPS-Fehler: '+e.message},{enableHighAccuracy:true,maximumAge:1000,timeout:10000});$('gpsStatus').textContent='GPS: aktiv';$('homeLive').textContent='Fahrt läuft';tick()}
function onPos(p){const c=p.coords;const pt={lat:c.latitude,lon:c.longitude,alt:c.altitude,speed:c.speed,ts:Date.now(),acc:c.accuracy};if(S.lastPos){S.distance+=hav(S.lastPos.lat,S.lastPos.lon,pt.lat,pt.lon)}S.lastPos=pt;S.track.push(pt);drawTrack();$('liveAlt').textContent=Number.isFinite(pt.alt)?Math.round(pt.alt)+' m':'– m';$('liveSpeed').textContent=Number.isFinite(pt.speed)?(pt.speed*3.6).toFixed(1)+' km/h':'– km/h';$('gpsDetail').innerHTML=`${pt.lat.toFixed(5)}, ${pt.lon.toFixed(5)} · Genauigkeit ±${Math.round(pt.acc)} m`;$('gpsStatus').textContent='GPS: aktiv'}
function drawTrack(){if(!S.flightMap||!S.track.length)return;const arr=S.track.map(p=>[p.lat,p.lon]);S.flightLine.setLatLngs(arr);S.flightMap.setView(arr[arr.length-1],Math.max(S.flightMap.getZoom(),12))}
function stopFlight(){if(!S.flightActive)return;S.flightActive=false;if(S.watch!=null)navigator.geolocation.clearWatch(S.watch);S.watch=null;$('gpsStatus').textContent='GPS: aus';$('homeLive').textContent='Fahrt beendet – bitte speichern.'}
function tick(){if(!S.flightActive)return;const sec=Math.floor((Date.now()-S.startTs)/1000);$('liveTime').textContent=fmt(sec);$('liveDist').textContent=S.distance.toFixed(2)+' km';setTimeout(tick,1000)}
function saveFlight(){if(!S.startTs&&!S.track.length)return alert('Keine Fahrt vorhanden.');const end=Date.now(),start=S.startTs||end-(+S.pDur?.value||1.5)*3600000;const f={id:Date.now(),date:new Date(start).toISOString(),pilot:S.master.pilot||'',balloon:S.master.balloon||'',type:S.master.type||'',duration:Math.round((end-start)/60000),distance:+S.distance.toFixed(2),landings:+$('landings').value||0,remarks:$('remarks').value,track:S.track,plan:S.plan};S.flights.unshift(f);stopFlight();S.startTs=null;S.track=[];S.distance=0;$('remarks').value='';save();alert('Fahrt gespeichert.');show('book')}
function hav(a,b,c,d){const R=6371,rad=Math.PI/180;const x=(c-a)*rad,y=(d-b)*rad;const q=Math.sin(x/2)**2+Math.cos(a*rad)*Math.cos(c*rad)*Math.sin(y/2)**2;return R*2*Math.atan2(Math.sqrt(q),Math.sqrt(1-q))}
function fmt(sec){const h=Math.floor(sec/3600),m=Math.floor(sec%3600/60),s=sec%60;return h?`${h}:${String(m).padStart(2,'0')}:${String(s).padStart(2,'0')}`:`${m}:${String(s).padStart(2,'0')}`}
function render(){const fs=S.flights;let mins=fs.reduce((a,f)=>a+(f.duration||0),0),km=fs.reduce((a,f)=>a+(f.distance||0),0),land=fs.reduce((a,f)=>a+(f.landings||0),0);$('mFlights').textContent=fs.length;$('mLandings').textContent=land;$('mTime').textContent=(mins/60).toFixed(1)+' h';$('mDistance').textContent=km.toFixed(1)+' km';$('homeMaster').textContent=[S.master.pilot,S.master.balloon,S.master.type].filter(Boolean).join(' · ')||'Noch nicht hinterlegt';$('recent').innerHTML=fs.slice(0,5).map(f=>`<div class="card flight"><div><strong>${new Date(f.date).toLocaleString('de-AT')} · ${f.distance||0} km</strong><span class="muted">${f.pilot||'–'} · ${f.balloon||'–'} · ${f.duration||0} min</span></div><span class="pill">${f.landings||0} Landung(en)</span></div>`).join('')||'<div class="empty">Noch keine Fahrten gespeichert.</div>';if(S.master){$('pilot').value=S.master.pilot||'';$('balloon').value=S.master.balloon||'';$('type').value=S.master.type||'';$('service').value=S.master.service||''}}
function renderBook(){$('bookList').innerHTML=S.flights.map(f=>`<div class="card flight"><div><strong>${new Date(f.date).toLocaleString('de-AT')}</strong><div class="muted">${f.pilot||'–'} · ${f.balloon||'–'} · ${f.distance||0} km · ${f.duration||0} min · ${f.landings||0} Landungen</div><div>${f.remarks||''}</div></div><button onclick="deleteFlight(${f.id})">Löschen</button></div>`).join('')||'<div class="empty">Noch keine Fahrten.</div>'}
function deleteFlight(id){if(confirm('Fahrt löschen?')){S.flights=S.flights.filter(f=>f.id!==id);save();renderBook()}}
function saveMaster(){S.master={pilot:$('pilot').value,balloon:$('balloon').value,type:$('type').value,service:$('service').value};save();alert('Gespeichert.')}
function exportJSON(){const blob=new Blob([JSON.stringify({version:2,flights:S.flights,master:S.master},null,2)],{type:'application/json'});download(blob,'ballonflugbuch-v2.json')}
function exportCSV(){const rows=[['Datum','Pilot','Ballon','Flugzeit_min','Distanz_km','Landungen','Bemerkungen'],...S.flights.map(f=>[new Date(f.date).toISOString(),f.pilot,f.balloon,f.duration,f.distance,f.landings,(f.remarks||'').replaceAll(';',',')])];download(new Blob([rows.map(r=>r.join(';')).join('\n')],{type:'text/csv'}),'ballonflugbuch.csv')}
function download(blob,name){const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download=name;a.click();setTimeout(()=>URL.revokeObjectURL(a.href),1000)}
function importJSON(){const file=$('importFile').files[0];if(!file)return alert('Datei auswählen.');const r=new FileReader();r.onload=()=>{try{const d=JSON.parse(r.result);if(Array.isArray(d))S.flights=d;else{S.flights=d.flights||[];S.master=d.master||S.master}save();alert('Import erfolgreich.')}catch(e){alert('Ungültiges JSON')}};r.readAsText(file)}
function clearAll(){if(confirm('Wirklich alle Fahrten löschen?')){S.flights=[];save()}}
async function locateWeather(){try{navigator.geolocation.getCurrentPosition(async p=>{const d=await fetch(`https://api.open-meteo.com/v1/forecast?latitude=${p.coords.latitude}&longitude=${p.coords.longitude}&current=temperature_2m,wind_speed_10m,wind_direction_10m&timezone=auto`).then(r=>r.json());$('homeWeather').textContent=`${d.current.temperature_2m} °C · Wind ${d.current.wind_speed_10m} km/h · ${d.current.wind_direction_10m}°`})}catch(e){}}
$('backupBtn').onclick=exportJSON;const today=new Date();$('pDate').value=today.toISOString().slice(0,10);$('pTime').value=String(today.getHours()).padStart(2,'0')+':'+String(today.getMinutes()).padStart(2,'0');render();show('home');
</script></body></html>
